 url_MongoDB=mongodb://127.0.0.1:27017/your_database_name
# PORT=5000
# JWT_SECRET=your_jwt_secret_here
url_MongoDB=mongodb://127.0.0.1:27017/your_database_name
PORT=5000
JWT_SECRET=your_jwt_secret_here

# Email notifications
EMAIL_USER=your_email@example.com
EMAIL_APP_PASSWORD=your_email_app_password_here
FRONTEND_URL=http://localhost:5173

# Google Calendar (OAuth 2.0)
# Public template: keep real credentials in the ignored .env file.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback
GOOGLE_CALENDAR_TIMEZONE=Africa/Tunis
GOOGLE_TOKEN_ENC_KEY=your_64_character_hex_encryption_key_here
# Required only when running node seedAdmin.js; choose a strong private password.
ADMIN_PASSWORD=your_admin_password_here
