// CV upload — saves file then auto-parses ATS data into CVInfo
exports.uploadCV = async (req, res) => {
  try {
    if (req.user.role !== "candidate") {
      return res.status(403).json({ message: "Only candidates can upload CV" });
    }
    if (!req.file) return res.status(400).json({ message: "No file uploaded" });

    const cvPath = "/uploads/" + req.file.filename;

    const user = await User.findByIdAndUpdate(
      req.user.id,
      { cv: cvPath },
      { new: true }
    ).select("-password");

    // Parse CV asynchronously — failure must not block the upload response
    const absoluteFilePath = path.join(__dirname, "..", "uploads", req.file.filename);
    try {
      const parsed = await parseCV(absoluteFilePath);
      if (!parsed.fullName) parsed.fullName = user.name || "";
      if (!parsed.email)    parsed.email    = user.email || "";
      await CVInfo.findOneAndUpdate(
        { user: req.user.id },
        { ...parsed, user: req.user.id },
        { upsert: true, new: true, setDefaultsOnInsert: true }
      );
    } catch (parseErr) {
      console.error("[uploadCV] CV parsing failed:", parseErr.message);
    }

    res.status(200).json({ message: "CV uploaded successfully", user });
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
};

