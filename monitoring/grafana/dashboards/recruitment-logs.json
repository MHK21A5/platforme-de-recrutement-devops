{
  "id": null,
  "uid": "recruitment-logs",
  "title": "Recruitment Platform - Logs",
  "tags": ["recruitment", "logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1, "title": "Backend Logs", "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "{container=\"recruitment-backend\"}", "queryType": "range" }
      ],
      "options": { "showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true }
    },
    {
      "id": 2, "title": "Frontend Logs", "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "{container=\"recruitment-frontend\"}", "queryType": "range" }
      ],
      "options": { "showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true }
    },
    {
      "id": 3, "title": "Error Logs", "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 10 },
      "targets": [
        { "refId": "A", "expr": "{container=~\"recruitment-(backend|frontend|prometheus|grafana|node-exporter|cadvisor|loki)\"} |~ \"(?i)(error|exception|failed|fatal)\"", "queryType": "range" }
      ],
      "options": { "showTime": true, "showLabels": true, "showCommonLabels": false, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true }
    },
    {
      "id": 4, "title": "Logs by Container", "type": "timeseries",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 10 },
      "targets": [
        { "refId": "A", "expr": "sum by (container) (rate({container=~\"recruitment-(backend|frontend|prometheus|grafana|node-exporter|cadvisor|loki)\"}[5m]))", "queryType": "range", "legendFormat": "{{container}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 5, "title": "Recent All Application Logs", "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 20 },
      "targets": [
        { "refId": "A", "expr": "{container=~\"recruitment-(backend|frontend|prometheus|grafana|node-exporter|cadvisor|loki)\"}", "queryType": "range" }
      ],
      "options": { "showTime": true, "showLabels": true, "showCommonLabels": false, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true }
    }
  ]
}
